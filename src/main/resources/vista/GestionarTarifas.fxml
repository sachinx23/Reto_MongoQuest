<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- GESTIONAR TARIFAS -->
<AnchorPane styleClass="panel-contenido" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.GestionTarifasController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <children>
            <Label styleClass="titulo-principal" text="Tarifas" />
            <GridPane hgap="12.0" vgap="10.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="95.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
                  <ColumnConstraints minWidth="95.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <children>
                  <Label styleClass="label-bold" text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label styleClass="label-bold" text="Precio (€)" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <TextField fx:id="txtPrecio" GridPane.columnIndex="3" GridPane.rowIndex="0">
                     <tooltip>
                        <Tooltip text="Número, por ejemplo 29.99" />
                     </tooltip>
                  </TextField>
                  <Label styleClass="label-bold" text="Tipo" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <ComboBox fx:id="cmbTipo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label styleClass="label-bold" text="Activa" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <CheckBox fx:id="chkActiva" text="Los clientes la pueden contratar" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                  <Label styleClass="label-bold" text="Detalles" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <TextArea fx:id="txtDetalles" prefRowCount="2" wrapText="true" GridPane.columnSpan="3" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </children>
            </GridPane>
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tablaTarifas" onMouseClicked="#seleccionarTarifa" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <contextMenu>
                        <ContextMenu>
                           <items>
                              <MenuItem mnemonicParsing="false" onAction="#btnActivar" text="Activar / desactivar" />
                              <MenuItem mnemonicParsing="false" onAction="#btnEliminar" text="Eliminar" />
                           </items>
                        </ContextMenu>
                     </contextMenu>
                     <columns>
                        <TableColumn fx:id="colNombre" text="Tarifa" />
                        <TableColumn fx:id="colPrecio" text="Precio" />
                        <TableColumn fx:id="colTipo" text="Tipo" />
                        <TableColumn fx:id="colDetalles" text="Detalles" />
                        <TableColumn fx:id="colActiva" text="Activa" />
                     </columns>
                  </TableView>
                  <VBox minWidth="170.0" spacing="10.0">
                     <children>
                        <Button fx:id="btnGuardar" maxWidth="Infinity" mnemonicParsing="true" onAction="#btnGuardar" styleClass="btn-primary" text="_Guardar nueva">
                           <tooltip>
                              <Tooltip text="Crea una tarifa con los datos del formulario (Alt+G)" />
                           </tooltip>
                        </Button>
                        <Button fx:id="btnActualizar" maxWidth="Infinity" mnemonicParsing="true" onAction="#btnActualizar" styleClass="btn-secondary" text="Ac_tualizar">
                           <tooltip>
                              <Tooltip text="Guarda los cambios de la tarifa seleccionada (Alt+T)" />
                           </tooltip>
                        </Button>
                        <Button fx:id="btnActivar" maxWidth="Infinity" mnemonicParsing="true" onAction="#btnActivar" styleClass="btn-secondary" text="Acti_var / desactivar">
                           <tooltip>
                              <Tooltip text="Una tarifa desactivada no la ven los clientes (Alt+V)" />
                           </tooltip>
                        </Button>
                        <Button fx:id="btnEliminar" maxWidth="Infinity" mnemonicParsing="true" onAction="#btnEliminar" styleClass="btn-danger" text="_Eliminar">
                           <tooltip>
                              <Tooltip text="Borra la tarifa si no tiene contratos (Alt+E)" />
                           </tooltip>
                        </Button>
                        <Button fx:id="btnLimpiar" maxWidth="Infinity" mnemonicParsing="true" onAction="#btnLimpiar" styleClass="btn-secondary" text="_Limpiar">
                           <tooltip>
                              <Tooltip text="Vacía el formulario (Alt+L)" />
                           </tooltip>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
