<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="20.0" stylesheets="@../css/Estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.GestionTarifasController">
   <children>
      <VBox prefWidth="320.0" spacing="12.0" styleClass="card">
         <children>
            <Label styleClass="titulo-principal" text="Datos de la Tarifa" />
            
            <GridPane vgap="10.0">
               <children>
                  <VBox spacing="4.0" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="label-bold" text="Nombre de la Tarifa:" />
                        <TextField fx:id="txtNombre" promptText="Ej: Onda Fibra 300Mb" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="label-bold" text="Precio (€):" />
                        <TextField fx:id="txtPrecio" promptText="Ej: 29.99" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0" GridPane.rowIndex="2">
                     <children>
                        <Label styleClass="label-bold" text="Tipo de Tarifa:" />
                        <ComboBox fx:id="comboTipo" maxWidth="Infinity" promptText="Selecciona tipo">
                           <styleClass>
                              <String fx:value="combo-admin" />
                           </styleClass>
                        </ComboBox>
                     </children>
                  </VBox>
                  <VBox spacing="4.0" GridPane.rowIndex="3">
                     <children>
                        <Label styleClass="label-bold" text="Detalles / Descripción:" />
                        <TextArea fx:id="txtDetalles" prefHeight="70.0" promptText="Características de la tarifa..." wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </GridPane>
            
            <CheckBox fx:id="chkActiva" mnemonicParsing="false" selected="true" styleClass="label-bold" text="Tarifa Activa / Disponible" />
            
            <VBox spacing="8.0">
               <children>
                  <Button fx:id="btnGuardar" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnGuardarAccion" styleClass="btn-primary" text="Guardar Nueva" />
                  <HBox spacing="10.0">
                     <children>
                        <Button fx:id="btnActualizar" prefWidth="130.0" mnemonicParsing="false" onAction="#btnActualizarAccion" styleClass="btn-secondary" text="Actualizar" />
                        <Button fx:id="btnEliminar" prefWidth="130.0" mnemonicParsing="false" onAction="#btnEliminarAccion" styleClass="btn-danger" text="Eliminar" />
                     </children>
                  </HBox>
                  <Button fx:id="btnLimpiar" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnLimpiarAccion" styleClass="boton-cerrar" text="Limpiar Campos" />
               </children>
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </VBox>
         </children>
      </VBox>
      
      <VBox prefWidth="500.0" spacing="10.0" styleClass="card">
         <children>
            <Label styleClass="titulo-principal" text="Listado de Tarifas Registradas" />
            <TableView fx:id="tablaTarifas" prefHeight="350.0" prefWidth="480.0">
              <columns>
                <TableColumn fx:id="colNombre" prefWidth="120.0" text="Nombre" />
                <TableColumn fx:id="colPrecio" prefWidth="70.0" text="Precio (€)" />
                <TableColumn fx:id="colTipo" prefWidth="80.0" text="Tipo" />
                <TableColumn fx:id="colDetalles" prefWidth="150.0" text="Detalles" />
                <TableColumn fx:id="colActiva" prefWidth="60.0" text="Activa" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
</HBox>