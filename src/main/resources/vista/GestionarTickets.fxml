<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- TICKETS DE SOPORTE -->
<AnchorPane styleClass="panel-contenido" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.TicketsSoporteController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <children>
            <Label styleClass="titulo-principal" text="Tickets de soporte" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label styleClass="label-bold" text="Estado" />
                  <ComboBox fx:id="cmbFiltroEstado" onAction="#cmbFiltrar" prefWidth="160.0">
                     <tooltip>
                        <Tooltip text="Enseña solo los tickets de ese estado" />
                     </tooltip>
                  </ComboBox>
               </children>
            </HBox>
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tablaTickets" onMouseClicked="#seleccionarTicket" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <contextMenu>
                        <ContextMenu>
                           <items>
                              <MenuItem mnemonicParsing="false" onAction="#btnResolver" text="Resolver ticket" />
                           </items>
                        </ContextMenu>
                     </contextMenu>
                     <columns>
                        <TableColumn fx:id="colCliente" text="Cliente" />
                        <TableColumn fx:id="colAsunto" text="Asunto" />
                        <TableColumn fx:id="colFecha" text="Fecha" />
                        <TableColumn fx:id="colEstado" text="Estado" />
                     </columns>
                  </TableView>
                  <VBox minWidth="170.0" spacing="10.0">
                     <children>
                        <Button fx:id="btnResolver" maxWidth="Infinity" mnemonicParsing="true" onAction="#btnResolver" styleClass="btn-primary" text="_Resolver">
                           <tooltip>
                              <Tooltip text="Marca como resuelto el ticket seleccionado (Alt+R)" />
                           </tooltip>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Label styleClass="label-bold" text="Descripción del ticket seleccionado" />
            <TextArea fx:id="txtDescripcion" editable="false" prefRowCount="3" wrapText="true" />
         </children>
      </VBox>
   </children>
</AnchorPane>
