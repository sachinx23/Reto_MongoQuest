<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="950.0" 
            styleClass="fondo-pantalla" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controlador.TicketsSoporteController">
   <stylesheets>
      <URL value="@../css/Estilos.css" />
   </stylesheets>
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>

            <!-- TARJETA SUPERIOR: CABECERA Y FILTRO DE ESTADO -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
               <children>
                  <Label styleClass="titulo-vista" text="Tickets de Soporte" />
                  <Region HBox.hgrow="ALWAYS" />
                  
                  <Label styleClass="label-bold" text="Filtrar por Estado:" />
                  <ComboBox fx:id="comboFiltroEstado" onAction="#filtrarTickets" prefWidth="160.0" styleClass="combo-box" />
                  
                  <Button onAction="#refrescar" styleClass="btn-refrescar" text="Refrescar" />
               </children>
            </HBox>

            <!-- TABLA PRINCIPAL DE TICKETS -->
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tablaTickets" onMouseClicked="#seleccionarTicket" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colIdTicket" prefWidth="150.0" text="ID Ticket" />
                        <TableColumn fx:id="colAsunto" prefWidth="220.0" text="Asunto" />
                        <TableColumn fx:id="colFecha" prefWidth="110.0" text="Fecha" />
                        <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado" />
                        <TableColumn fx:id="colIdCliente" prefWidth="150.0" text="ID Cliente" />
                        <TableColumn fx:id="colIdEmpleado" prefWidth="150.0" text="ID Empleado" />
                     </columns>
                  </TableView>
               </children>
            </VBox>

            <!-- DETALLE Y DESCRIPCIÓN DEL TICKET SELECCIONADO -->
            <VBox spacing="6.0" styleClass="card">
               <children>
                  <Label styleClass="label-bold" text="Descripción del Incidente:" />
                  <TextArea fx:id="txtDescripcion" editable="false" prefHeight="90.0" promptText="Selecciona un ticket para visualizar el contenido del mensaje..." styleClass="text-area" wrapText="true" />
               </children>
            </VBox>

            <!-- ACCIONES: ASIGNACIÓN Y CAMBIO DE ESTADO -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
               <children>
                  <Button onAction="#asignarTicket" styleClass="btn-aceptar" text="Asignar (Me hago cargo)" />
                  <Region HBox.hgrow="ALWAYS" />
                  
                  <Label styleClass="label-bold" text="Nuevo Estado:" />
                  <ComboBox fx:id="comboNuevoEstado" prefWidth="160.0" styleClass="combo-box" />
                  
                  <Button onAction="#cambiarEstado" styleClass="btn-primary" text="Cambiar Estado" />
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>