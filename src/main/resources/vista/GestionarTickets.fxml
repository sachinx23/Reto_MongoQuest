<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="950.0"
            stylesheets="@../css/Estilos.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controlador.TicketsSoporteController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>

            <!-- FILTRO -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="card">
               <children>
                  <Label styleClass="titulo-principal" text="Tickets de soporte" />
                  <Label styleClass="label-bold" text="Estado:" />
                  <ComboBox fx:id="comboFiltroEstado" onAction="#filtrarTickets" prefWidth="160.0" />
                  <Button onAction="#refrescar" styleClass="btn-refrescar" text="Refrescar" />
               </children>
            </HBox>

            <!-- TABLA -->
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tablaTickets" onMouseClicked="#seleccionarTicket" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colIdTicket" prefWidth="170.0" text="ID" />
                        <TableColumn fx:id="colAsunto" prefWidth="220.0" text="Asunto" />
                        <TableColumn fx:id="colFecha" prefWidth="100.0" text="Fecha" />
                        <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
                        <TableColumn fx:id="colIdCliente" prefWidth="170.0" text="Cliente" />
                        <TableColumn fx:id="colIdEmpleado" prefWidth="170.0" text="Empleado" />
                     </columns>
                  </TableView>
               </children>
            </VBox>

            <!-- DESCRIPCIÓN -->
            <VBox spacing="8.0" styleClass="card">
               <children>
                  <Label styleClass="label-bold" text="Descripción:" />
                  <TextArea fx:id="txtDescripcion" prefHeight="100.0" wrapText="true" />
               </children>
            </VBox>

            <!-- ACCIONES -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="card">
               <children>
                  <Button onAction="#asignarTicket" styleClass="btn-aceptar" text="Asignar (me hago cargo)" />
                  <Label styleClass="label-bold" text="Nuevo estado:" />
                  <ComboBox fx:id="comboNuevoEstado" prefWidth="160.0" />
                  <Button onAction="#cambiarEstado" styleClass="btn-primary" text="Cambiar estado" />
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>