<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" 
            styleClass="fondo-pantalla" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controlador.GestionarPlantillaController">
   <stylesheets>
      <URL value="@../css/Estilos.css" />
   </stylesheets>
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
         
            <!-- SECCIÓN 1: PLANTILLA DE EMPLEADOS -->
            <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label styleClass="titulo-vista" text="Plantilla de Empleados" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#alternarFormulario" styleClass="btn-aceptar" text="+ Crear Empleado" />
                        <Button onAction="#ascenderAAdmin" styleClass="btn-filtrar" text="Ascender a Admin" />
                        <Button onAction="#eliminarEmpleado" styleClass="btn-danger" text="Dar de Baja Empleado" />
                     </children>
                  </HBox>

                  <!-- PANEL DEL FORMULARIO INTEGRADO (Oculto por defecto) -->
                  <VBox fx:id="panelFormulario" managed="false" visible="false" spacing="8.0" style="-fx-padding: 10; -fx-background-color: #f4f6f9; -fx-border-color: #dcdcdc; -fx-border-radius: 5;">
                     <children>
                        <Label text="Nuevo Empleado" style="-fx-font-weight: bold;" />
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                           <children>
                              <TextField fx:id="txtNombre" promptText="Nombre" prefWidth="110.0" />
                              <TextField fx:id="txtApellidos" promptText="Apellidos" prefWidth="130.0" />
                              <TextField fx:id="txtDireccion" promptText="Dirección" HBox.hgrow="ALWAYS" />
                              <!-- Sustituido TextField por ComboBox -->
                              <ComboBox fx:id="cmbIdSucursal" promptText="Ubicacion" prefWidth="120.0" />
                              <TextField fx:id="txtIban" promptText="IBAN" prefWidth="150.0" />
                              <Button onAction="#crearEmpleado" styleClass="btn-aceptar" text="Guardar" />
                              <Button onAction="#cancelarFormulario" styleClass="btn-danger" text="Cancelar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- TABLA DE EMPLEADOS -->
                  <TableView fx:id="tablaEmpleados" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colEmpNombre" prefWidth="110.0" text="Nombre" />
                        <TableColumn fx:id="colEmpApellidos" prefWidth="130.0" text="Apellidos" />
                        <TableColumn fx:id="colEmpUsuario" prefWidth="100.0" text="Usuario" />
                        <TableColumn fx:id="colEmpRol" prefWidth="80.0" text="Rol" />
                        <TableColumn fx:id="colEmpEmail" prefWidth="150.0" text="Email" />
                        <TableColumn fx:id="colEmpDireccion" prefWidth="150.0" text="Dirección" />
                        <TableColumn fx:id="colEmpSucursal" prefWidth="90.0" text="ID Sucursal" />
                        <TableColumn fx:id="colEmpIBAN" prefWidth="160.0" text="Cuenta Bancaria (IBAN)" />
                     </columns>
                  </TableView>
               </children>
            </VBox>

            <!-- SECCIÓN 2: GESTIÓN DE CLIENTES -->
            <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label styleClass="titulo-vista" text="Gestión de Clientes" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#eliminarCliente" styleClass="btn-danger" text="Eliminar Datos Sensibles" />
                     </children>
                  </HBox>

                  <!-- TABLA DE CLIENTES -->
                  <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colCliNombre" prefWidth="100.0" text="Nombre" />
                        <TableColumn fx:id="colCliApellidos" prefWidth="120.0" text="Apellidos" />
                        <TableColumn fx:id="colCliUsuario" prefWidth="100.0" text="Usuario" />
                        <TableColumn fx:id="colCliEmail" prefWidth="150.0" text="Email" />
                        <TableColumn fx:id="colCliTelefono" prefWidth="100.0" text="Teléfono" />
                        <TableColumn fx:id="colCliDni" prefWidth="100.0" text="DNI" />
                        <TableColumn fx:id="colCliDireccion" prefWidth="150.0" text="Dirección" />
                     </columns>
                  </TableView>
               </children>
            </VBox>

         </children>
      </VBox>
   </children>
</AnchorPane>