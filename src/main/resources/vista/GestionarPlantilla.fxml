<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="550.0" prefWidth="900.0" style="-fx-background-color: #1e293b;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.GestionarPlantillaController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
            
            <!-- SECCIÓN EMPLEADOS -->
            <VBox spacing="10.0" style="-fx-background-color: #0f172a; -fx-padding: 12; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Plantilla de Empleados" textFill="WHITE" />
                        <HBox HBox.hgrow="ALWAYS" />
                        <!-- BOTÓN CREAR EMPLEADO AÑADIDO -->
                        <Button onAction="#crearEmpleado" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="+ Crear Empleado" />
                        <Button onAction="#ascenderAAdmin" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Ascender a Admin" />
                        <Button onAction="#eliminarEmpleado" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Dar de Baja Empleado" />
                     </children>
                  </HBox>

                  <TableView fx:id="tablaEmpleados" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colEmpNombre" prefWidth="150.0" text="Nombre" />
                        <TableColumn fx:id="colEmpUsuario" prefWidth="150.0" text="Usuario" />
                        <TableColumn fx:id="colEmpRol" prefWidth="120.0" text="Rol" />
                        <TableColumn fx:id="colEmpEmail" prefWidth="200.0" text="Email" />
                     </columns>
                  </TableView>
               </children>
            </VBox>

            <!-- SECCIÓN CLIENTES -->
            <VBox spacing="10.0" style="-fx-background-color: #0f172a; -fx-padding: 12; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Listado de Clientes" textFill="WHITE" />
                        <HBox HBox.hgrow="ALWAYS" />
                        <Button onAction="#eliminarCliente" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Eliminar Datos Sensibles" />
                     </children>
                  </HBox>
                  
                  <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colCliNombre" prefWidth="150.0" text="Nombre" />
                        <TableColumn fx:id="colCliUsuario" prefWidth="150.0" text="Usuario" />
                        <TableColumn fx:id="colCliEmail" prefWidth="200.0" text="Email" />
                        <TableColumn fx:id="colCliTelefono" prefWidth="130.0" text="Teléfono" />
                     </columns>
                  </TableView>
               </children>
            </VBox>

         </children>
      </VBox>
   </children>
</AnchorPane>