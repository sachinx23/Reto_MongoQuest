<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- GESTIONAR PLANTILLA: empleados y clientes -->
<AnchorPane styleClass="panel-contenido" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.GestionarPlantillaController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <children>
            <Label styleClass="titulo-principal" text="Plantilla de empleados" />
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tablaEmpleados" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <contextMenu>
                        <ContextMenu>
                           <items>
                              <MenuItem mnemonicParsing="false" onAction="#btnAscender" text="Ascender a administrador" />
                              <MenuItem mnemonicParsing="false" onAction="#btnBorrarEmpleado" text="Eliminar empleado" />
                           </items>
                        </ContextMenu>
                     </contextMenu>
                     <columns>
                        <TableColumn fx:id="colEmpNombre" text="Nombre" />
                        <TableColumn fx:id="colEmpUsuario" text="Usuario" />
                        <TableColumn fx:id="colEmpRol" text="Rol" />
                        <TableColumn fx:id="colEmpCorreo" text="Correo" />
                        <TableColumn fx:id="colEmpCuenta" text="Cuenta bancaria" />
                     </columns>
                  </TableView>
                  <VBox minWidth="170.0" spacing="10.0">
                     <children>
                        <Button fx:id="btnAscender" maxWidth="Infinity" mnemonicParsing="true" onAction="#btnAscender" styleClass="btn-primary" text="_Ascender a admin">
                           <tooltip>
                              <Tooltip text="Convierte al empleado seleccionado en administrador (Alt+A)" />
                           </tooltip>
                        </Button>
                        <Button fx:id="btnBorrarEmpleado" maxWidth="Infinity" mnemonicParsing="true" onAction="#btnBorrarEmpleado" styleClass="btn-danger" text="_Eliminar empleado">
                           <tooltip>
                              <Tooltip text="Borra la cuenta del empleado seleccionado (Alt+E)" />
                           </tooltip>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Label styleClass="label-bold" text="Nuevo empleado" />
            <GridPane hgap="12.0" vgap="10.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="95.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
                  <ColumnConstraints minWidth="95.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <children>
                  <Label styleClass="label-bold" text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label styleClass="label-bold" text="Usuario" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <TextField fx:id="txtNombreUsuario" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                  <Label styleClass="label-bold" text="Contraseña" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <PasswordField fx:id="txtContrasena" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <tooltip>
                        <Tooltip text="Mínimo 4 caracteres" />
                     </tooltip>
                  </PasswordField>
                  <Label styleClass="label-bold" text="Correo" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <TextField fx:id="txtCorreo" GridPane.columnIndex="3" GridPane.rowIndex="1">
                     <tooltip>
                        <Tooltip text="Ejemplo: nombre@gmail.com" />
                     </tooltip>
                  </TextField>
                  <Label styleClass="label-bold" text="Sucursal" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <ComboBox fx:id="cmbSucursal" maxWidth="Infinity" promptText="(opcional)" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </children>
            </GridPane>
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <Button fx:id="btnCrearEmpleado" mnemonicParsing="true" onAction="#btnCrearEmpleado" styleClass="btn-primary" text="_Crear empleado">
                     <tooltip>
                        <Tooltip text="Da de alta al nuevo empleado (Alt+C)" />
                     </tooltip>
                  </Button>
               </children>
            </HBox>
            <Label styleClass="titulo-principal" text="Clientes" />
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tablaClientes" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <contextMenu>
                        <ContextMenu>
                           <items>
                              <MenuItem mnemonicParsing="false" onAction="#btnBorrarDatosCliente" text="Borrar datos sensibles" />
                           </items>
                        </ContextMenu>
                     </contextMenu>
                     <columns>
                        <TableColumn fx:id="colCliNombre" text="Nombre" />
                        <TableColumn fx:id="colCliUsuario" text="Usuario" />
                        <TableColumn fx:id="colCliDni" text="DNI / NIE" />
                        <TableColumn fx:id="colCliTelefono" text="Teléfono" />
                        <TableColumn fx:id="colCliEstado" text="Estado" />
                     </columns>
                  </TableView>
                  <VBox minWidth="170.0" spacing="10.0">
                     <children>
                        <Button fx:id="btnBorrarDatosCliente" maxWidth="Infinity" mnemonicParsing="true" onAction="#btnBorrarDatosCliente" styleClass="btn-danger" text="Borrar _datos">
                           <tooltip>
                              <Tooltip text="Borra cuenta, teléfono y dirección de un cliente dado de baja (Alt+D)" />
                           </tooltip>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
