<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../css/Estilos.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.ClienteContratosController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="card">
               <children>
                  <Label styleClass="titulo-vista" text="Mis contratos" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnFirmarContrato" mnemonicParsing="true" onAction="#btnFirmarContrato" styleClass="btn-aceptar" text="_Firmar contrato">
                     <tooltip>
                        <Tooltip text="Muestra si el contrato seleccionado está firmado (Alt+F)" />
                     </tooltip>
                  </Button>
                  <Button fx:id="btnRescindirContrato" mnemonicParsing="true" onAction="#btnRescindirContrato" styleClass="btn-danger" text="_Rescindir contrato">
                     <tooltip>
                        <Tooltip text="Pide la baja del contrato seleccionado (Alt+R)" />
                     </tooltip>
                  </Button>
               </children>
            </HBox>
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tablaContratos" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <contextMenu>
                        <ContextMenu>
                           <items>
                              <MenuItem mnemonicParsing="false" onAction="#btnFirmarContrato" text="Firmar contrato" />
                              <MenuItem mnemonicParsing="false" onAction="#btnRescindirContrato" text="Rescindir contrato" />
                           </items>
                        </ContextMenu>
                     </contextMenu>
                     <columns>
                        <TableColumn fx:id="colContratoIdTarifa" text="Tarifa" />
                        <TableColumn fx:id="colContratoTelefono" text="Teléfono" />
                        <TableColumn fx:id="colContratoEstado" text="Estado" />
                        <TableColumn fx:id="colContratoFecha" text="Fecha de fin" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
