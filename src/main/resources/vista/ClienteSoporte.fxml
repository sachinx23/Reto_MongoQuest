<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../css/Estilos.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.ClienteSoporteController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox spacing="12.0" styleClass="card">
               <children>
                  <Label styleClass="titulo-vista" text="Soporte" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <TextField fx:id="txtSoporteAsunto" prefWidth="220.0" promptText="Asunto (ej.: Sin conexión a internet)" />
                        <TextField fx:id="txtSoporteMensaje" promptText="Cuéntanos qué ocurre" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnEnviarTicket" mnemonicParsing="true" onAction="#btnEnviarTicket" styleClass="btn-aceptar" text="E_nviar ticket">
                           <tooltip>
                              <Tooltip text="Envía tu consulta al servicio de soporte (Alt+N)" />
                           </tooltip>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <Label styleClass="label-bold" text="Mis tickets" />
                  <TableView fx:id="tablaSoporte" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="colSoporteAsunto" text="Asunto" />
                        <TableColumn fx:id="colSoporteFecha" text="Fecha" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
