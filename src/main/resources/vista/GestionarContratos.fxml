<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" style="-fx-background-color: #0f172a;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.GestionarContratosController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <!-- TÍTULO DE LA SECCIÓN -->
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gestión y Consulta de Contratos - Tel-ONDA" textFill="WHITE" />
      
      <!-- TABLA DE CONTRATOS (Mapeada con el esquema de MongoDB) -->
      <TableView fx:id="tablaContratos" VBox.vgrow="ALWAYS" style="-fx-background-color: #1e293b; -fx-text-fill: white;">
        <columns>
          <TableColumn fx:id="colId" prefWidth="110.0" text="ID Contrato" />
          <TableColumn fx:id="colTelefono" prefWidth="100.0" text="Teléfono" />
          <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado" />
          <TableColumn fx:id="colCliente" prefWidth="140.0" text="ID Cliente" />
          <TableColumn fx:id="colTarifa" prefWidth="140.0" text="ID Tarifa" />
          <TableColumn fx:id="colEmpleado" prefWidth="140.0" text="ID Empleado" />
          <TableColumn fx:id="colFechaInicio" prefWidth="110.0" text="F. Comienzo" />
          <TableColumn fx:id="colFechaFin" prefWidth="110.0" text="F. Fin" />
        </columns>
      </TableView>

      <!-- BOTONERA INFERIOR (Acciones de acuerdo a vuestros casos de uso) -->
      <HBox alignment="CENTER_RIGHT" spacing="12.0">
         <children>
            <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#handleActualizar" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Actualizar Lista" />
            <Button fx:id="btnRescindir" mnemonicParsing="false" onAction="#handleRescindirContrato" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Rescindir Contrato" />
         </children>
      </HBox>
   </children>
</VBox>