<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.GestionLogController">
   <children>
      <TableView fx:id="tablaLogs" prefHeight="400.0" prefWidth="700.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colFecha" prefWidth="140.0" text="Fecha / Hora" />
            <TableColumn fx:id="colNivel" prefWidth="80.0" text="Nivel" />
            <TableColumn fx:id="colUsuario" prefWidth="130.0" text="Usuario" />
            <TableColumn fx:id="colOrigen" prefWidth="180.0" text="Origen" />
            <TableColumn fx:id="colMensaje" prefWidth="250.0" text="Mensaje" />
         </columns>
      </TableView>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>