<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../css/Estilos.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.ClienteTarifasController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="card">
               <children>
                  <Label styleClass="titulo-vista" text="Tarifas disponibles" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnCambiarTarifa" mnemonicParsing="true" onAction="#btnCambiarTarifa" styleClass="btn-aceptar" text="_Contratar tarifa">
                     <tooltip>
                        <Tooltip text="Pide la tarifa seleccionada; un empleado la validará (Alt+C)" />
                     </tooltip>
                  </Button>
                  <Button fx:id="btnEliminarTarifa" mnemonicParsing="true" onAction="#btnEliminarTarifa" styleClass="btn-danger" text="_Eliminar petición">
                     <tooltip>
                        <Tooltip text="Borra tu petición de la tarifa seleccionada si aún no está validada (Alt+E)" />
                     </tooltip>
                  </Button>
               </children>
            </HBox>
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tablaTarifas" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <contextMenu>
                        <ContextMenu>
                           <items>
                              <MenuItem mnemonicParsing="false" onAction="#btnCambiarTarifa" text="Contratar esta tarifa" />
                              <MenuItem mnemonicParsing="false" onAction="#btnEliminarTarifa" text="Eliminar mi petición" />
                           </items>
                        </ContextMenu>
                     </contextMenu>
                     <columns>
                        <TableColumn fx:id="colTarifaNombre" text="Tarifa" />
                        <TableColumn fx:id="colTarifaPrecio" text="Precio (€)" />
                        <TableColumn fx:id="colTarifaDetalles" text="Detalles" />
                        <TableColumn fx:id="colTarifaTipo" text="Tipo" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
