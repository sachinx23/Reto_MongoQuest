<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="1150.0" 
            stylesheets="@../css/Estilos.css" 
            styleClass="fondo-pantalla"
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controlador.AdministradorController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
            
            <!-- BARRA SUPERIOR CON DEGRADADO DEL LOGO -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="barra-superior">
               <children>
                  <Label styleClass="titulo-barra" text="Panel Administrador:" />
                  
                  <!-- DESPLEGABLE CON ESTILO REDONDEADO Y LIMPIO -->
                  <ComboBox fx:id="cbOpcionesAdmin" onAction="#cambiarSubVista" prefWidth="280.0" promptText="Elegir opción..." styleClass="combo-empleado" />
                  
                  <Region HBox.hgrow="ALWAYS" />
                  
                  <Label fx:id="lblNombreAdmin" text="Admin: Usuario" styleClass="nombre-usuario" />
               </children>
            </HBox>

            <!-- CONTENEDOR DINÁMICO DE SUBVISTAS -->
            <StackPane fx:id="contenidoDinamico" styleClass="panel-contenido" VBox.vgrow="ALWAYS" />

         </children>
      </VBox>
   </children>
</AnchorPane>