<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane prefHeight="680.0" prefWidth="1050.0" styleClass="root-admin" stylesheets="@../css/Estilo.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.AdministradorController">
   <children>

      <!-- MENÚ: las mismas acciones que los botones de la cabecera, más Salir y Acerca de -->
      <MenuBar AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <menus>
            <Menu mnemonicParsing="true" text="_Archivo">
               <items>
                  <MenuItem onAction="#btnMiPerfil" text="Mi perfil" />
                  <MenuItem onAction="#btnCerrarSesion" text="Cerrar sesión" />
                  <SeparatorMenuItem />
                  <MenuItem onAction="#menuSalir" text="Salir" />
               </items>
            </Menu>
            <Menu mnemonicParsing="true" text="A_yuda">
               <items>
                  <MenuItem onAction="#menuAcercaDe" text="Acerca de Tel-ONDA" />
               </items>
            </Menu>
         </menus>
      </MenuBar>

      <!-- CABECERA: marca, nombre del administrador, Mi Perfil y opciones -->
      <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="15.0" styleClass="cabecera" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="25.0">
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label minWidth="-Infinity" styleClass="marca-tel" text="Tel" />
                  <Label minWidth="-Infinity" styleClass="marca-onda" text="-ONDA" />
               </children>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblBienvenida" minWidth="-Infinity" styleClass="texto-cabecera" style="-fx-font-weight: bold;" />
            <Button fx:id="btnMiPerfil" minWidth="-Infinity" mnemonicParsing="true" onAction="#btnMiPerfil" styleClass="boton-cabecera" text="Mi _Perfil">
               <tooltip>
                  <Tooltip text="Ver y modificar tus datos (Alt+P)" />
               </tooltip>
            </Button>
            <ComboBox fx:id="cmbOpciones" minWidth="-Infinity" onAction="#cmbOpcionSeleccionada" prefWidth="230.0" styleClass="combo-admin">
               <tooltip>
                  <Tooltip text="Elige el apartado que quieres ver" />
               </tooltip>
            </ComboBox>
            <Button fx:id="btnCerrarSesion" minWidth="-Infinity" mnemonicParsing="true" onAction="#btnCerrarSesion" styleClass="boton-cerrar" text="Cerrar _sesión">
               <tooltip>
                  <Tooltip text="Volver a la pantalla de inicio de sesión (Alt+S)" />
               </tooltip>
            </Button>
         </children>
      </HBox>

      <!-- CONTENIDO: aquí se carga la pantalla del apartado elegido -->
      <StackPane fx:id="panelContenido" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="115.0" />
   </children>
</AnchorPane>
