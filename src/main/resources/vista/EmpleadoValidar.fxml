<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Validar tarifas: aceptar las peticiones pendientes. -->
<AnchorPane stylesheets="@../css/Estilos.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.EmpleadoValidarController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <!-- Cabecera: título y acciones -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="card">
               <children>
                  <Label styleClass="titulo-vista" text="Peticiones de tarifa pendientes" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnValidarTarifa" mnemonicParsing="true" onAction="#btnValidarTarifa" styleClass="btn-aceptar" text="_Validar">
                     <tooltip>
                        <Tooltip text="Activa la tarifa pedida por el cliente seleccionado (Alt+V)" />
                     </tooltip>
                  </Button>
               </children>
            </HBox>
            <!-- Tabla -->
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tablaPeticiones" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <contextMenu>
                        <ContextMenu>
                           <items>
                              <MenuItem mnemonicParsing="false" onAction="#btnValidarTarifa" text="Validar tarifa" />
                           </items>
                        </ContextMenu>
                     </contextMenu>
                     <columns>
                        <TableColumn fx:id="colPeticionCliente" text="Cliente" />
                        <TableColumn fx:id="colPeticionTarifa" text="Tarifa" />
                        <TableColumn fx:id="colPeticionPrecio" text="Precio (€)" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
