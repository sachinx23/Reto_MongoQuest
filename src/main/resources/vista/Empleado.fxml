<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="950.0" 
            stylesheets="@../css/Estilos.css" 
            styleClass="fondo-pantalla"
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controlador.EmpleadoController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
            
            <!-- BARRA SUPERIOR: DEGRADADO DEL LOGO -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="barra-superior">
               <children>
                  <Label styleClass="titulo-barra" text="Panel Empleado:" />
                  
                  <!-- DESPLEGABLE CON ESTILO REDONDEADO -->
                  <ComboBox fx:id="cbOpcionesEmpleado" onAction="#cambiarSubVista" prefWidth="250.0" promptText="Seleccionar sección..." styleClass="combo-empleado" />
                  
                  <Region HBox.hgrow="ALWAYS" />
                  
                  <Label fx:id="lblNombreEmpleado" styleClass="nombre-usuario" text="Empleado: Usuario" />
               </children>
            </HBox>

            <!-- FRANJA SEPARADORA TURQUESA DECORATIVA -->
            <AnchorPane prefHeight="3.0" styleClass="franja-turquesa" />

            <!-- CONTENEDOR DINÁMICO DE SUBVISTAS -->
            <StackPane fx:id="contenidoDinamico" styleClass="panel-contenido" VBox.vgrow="ALWAYS" />

         </children>
      </VBox>
   </children>
</AnchorPane>