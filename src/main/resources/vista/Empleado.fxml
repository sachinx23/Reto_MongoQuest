<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="420.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.EmpleadoController">
    <children>
        <Pane prefHeight="420.0" prefWidth="600.0">
            <children>
                <Label layoutX="14.0" layoutY="14.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Panel de empleado" />
                <Label fx:id="lblBienvenida" layoutX="150.0" layoutY="65.0" prefHeight="17.0" prefWidth="300.0" />
                <Button layoutX="14.0" layoutY="98.0" mnemonicParsing="false" onAction="#btnMiPerfil" prefWidth="130.0" text="Mi Perfil" />
                <ComboBox fx:id="cmbOpciones" layoutX="418.0" layoutY="98.0" onAction="#cmbOpcionSeleccionada" prefWidth="150.0" promptText="Opciones" />

                <Pane layoutX="14.5" layoutY="140.0" prefHeight="265.0" prefWidth="570.0">
                    <children>

                        <!-- PANEL PERFIL (solo lectura) -->
                        <AnchorPane fx:id="panelPerfil" prefHeight="265.0" prefWidth="570.0" visible="false" style="-fx-background-color: #f9f9f9; -fx-border-color: #cccccc;">
                            <children>
                                <Label layoutX="15.0" layoutY="10.0" text="Datos empleado">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Label>
                                <Label layoutX="15.0" layoutY="45.0" text="Nombre:" />
                                <Label fx:id="lblNombre" layoutX="130.0" layoutY="45.0" prefWidth="400.0" />
                                <Label layoutX="15.0" layoutY="80.0" text="Usuario:" />
                                <Label fx:id="lblNombreUsuario" layoutX="130.0" layoutY="80.0" prefWidth="400.0" />
                                <Label layoutX="15.0" layoutY="115.0" text="Correo:" />
                                <Label fx:id="lblCorreo" layoutX="130.0" layoutY="115.0" prefWidth="400.0" />
                                <Label layoutX="15.0" layoutY="150.0" text="Cuenta bancaria:" />
                                <Label fx:id="lblCuentaBancaria" layoutX="130.0" layoutY="150.0" prefWidth="400.0" />
                            </children>
                        </AnchorPane>

                        <!-- PANEL TICKETS PENDIENTES -->
                        <AnchorPane fx:id="panelTickets" prefHeight="265.0" prefWidth="570.0" visible="false">
                            <children>
                                <TableView fx:id="tablaTickets" prefHeight="210.0" prefWidth="430.0">
                                  <columns>
                                    <TableColumn fx:id="colTicketCliente" prefWidth="90.0" text="Cliente" />
                                    <TableColumn fx:id="colTicketAsunto" prefWidth="110.0" text="asunto" />
                                    <TableColumn fx:id="colTicketDescripcion" prefWidth="140.0" text="descripcion" />
                                    <TableColumn fx:id="colTicketFecha" prefWidth="90.0" text="fechaCreacion" />
                                  </columns>
                                </TableView>
                                <Button layoutX="445.0" layoutY="20.0" mnemonicParsing="false" onAction="#btnResolverTicket" prefWidth="115.0" text="Resolver" />
                            </children>
                        </AnchorPane>

                        <!-- PANEL SOLICITUDES DE BAJA -->
                        <AnchorPane fx:id="panelBajas" prefHeight="265.0" prefWidth="570.0" visible="false">
                            <children>
                                <TableView fx:id="tablaBajas" prefHeight="210.0" prefWidth="430.0">
                                  <columns>
                                    <TableColumn fx:id="colBajaCliente" prefWidth="110.0" text="Cliente" />
                                    <TableColumn fx:id="colBajaDni" prefWidth="90.0" text="DNI" />
                                    <TableColumn fx:id="colBajaTelefono" prefWidth="100.0" text="telefono" />
                                    <TableColumn fx:id="colBajaTarifa" prefWidth="130.0" text="Tarifa" />
                                  </columns>
                                </TableView>
                                <Button layoutX="445.0" layoutY="20.0" mnemonicParsing="false" onAction="#btnAprobarBaja" prefWidth="115.0" text="Aprobar baja" />
                            </children>
                        </AnchorPane>

                        <!-- PANEL VALIDAR TARIFAS -->
                        <AnchorPane fx:id="panelValidar" prefHeight="265.0" prefWidth="570.0" visible="false">
                            <children>
                                <TableView fx:id="tablaPeticiones" prefHeight="210.0" prefWidth="430.0">
                                  <columns>
                                    <TableColumn fx:id="colPeticionCliente" prefWidth="150.0" text="Cliente" />
                                    <TableColumn fx:id="colPeticionTarifa" prefWidth="180.0" text="nombreTarifa" />
                                    <TableColumn fx:id="colPeticionPrecio" prefWidth="100.0" text="precio" />
                                  </columns>
                                </TableView>
                                <Button layoutX="445.0" layoutY="20.0" mnemonicParsing="false" onAction="#btnValidarTarifa" prefWidth="115.0" text="Validar" />
                            </children>
                        </AnchorPane>

                    </children>
                </Pane>
            </children>
        </Pane>
    </children>
</AnchorPane>
