<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="650.0" 
            stylesheets="@/css/Estilos.css" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controlador.IniciarSesionController">
   <children>
      <VBox alignment="CENTER" prefWidth="380.0" spacing="15.0" styleClass="card" 
            AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="135.0" AnchorPane.rightAnchor="135.0" AnchorPane.topAnchor="40.0">
         <children>
            
            <Label styleClass="titulo-principal" style="-fx-font-size: 24px;" text="Tel-ONDA" />
            
            <Label text="Bienvenido, espero que disfrutes de una experiencia inolvidable" textFill="#64748b" />

            <VBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-padding: 10 0 0 0;">
               <children>
                  <Label styleClass="label-bold" text="Usuario:" />
                  <TextField fx:id="txtUsuario" promptText="Introduce tu usuario" />
               </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="5.0">
               <children>
                  <Label styleClass="label-bold" text="Contraseña:" />
                  <PasswordField fx:id="txtContrasena" promptText="Introduce tu contraseña" />
               </children>
            </VBox>

  
            <Label fx:id="lblMensajeError" alignment="CENTER" maxWidth="1.7976931348623157E308" 
                   style="-fx-font-size: 12px; -fx-font-weight: bold;" textFill="#e11d48" />

          
            <HBox alignment="CENTER" spacing="12.0" style="-fx-padding: 10 0 0 0;">
               <children>
                  <Button maxWidth="1.7976931348623157E308" minWidth="120.0" onAction="#btnIniciarSesion" 
                          styleClass="btn-primary" text="Iniciar Sesión" HBox.hgrow="ALWAYS" />
                  <Button maxWidth="1.7976931348623157E308" minWidth="120.0" onAction="#btnRegistrarse" 
                          styleClass="btn-secondary" text="Registrarse" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>