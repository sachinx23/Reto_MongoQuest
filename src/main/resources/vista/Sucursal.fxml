<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" 
            styleClass="scroll-subvista" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controlador.GestionSucursalController">
   <stylesheets>
      <URL value="@../css/Estilos.css" />
   </stylesheets>
   <content>
      <HBox minHeight="540.0" spacing="16.0" styleClass="fondo-pantalla">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>

            <!-- TARJETA IZQUIERDA: FORMULARIO Y LISTA DE SUCURSALES -->
            <VBox minWidth="360.0" prefWidth="400.0" spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="titulo-vista" text="Gestión de Sucursales" />

                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="label-bold" text="ID Sucursal:" />
                        <TextField fx:id="txtId" promptText="Ej: 1" styleClass="text-field" />
                     </children>
                  </VBox>

                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="label-bold" text="Horario:" />
                        <TextField fx:id="txtHorario" promptText="Ej: 08:00 - 20:00" styleClass="text-field" />
                     </children>
                  </VBox>

                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="label-bold" text="Teléfono:" />
                        <TextField fx:id="txtTelefono" promptText="Ej: 944123456" styleClass="text-field" />
                     </children>
                  </VBox>

                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="label-bold" text="Ubicación (Dirección):" />
                        <TextField fx:id="txtUbicacion" promptText="Ej: Lonbo Kalea, Bilbao" styleClass="text-field" />
                     </children>
                  </VBox>

                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="label-bold" text="Código Postal:" />
                        <TextField fx:id="txtCodigoPostal" promptText="Ej: 48480" styleClass="text-field" />
                     </children>
                  </VBox>

                  <!-- BOTONERA DE ACCIÓN -->
                  <HBox fx:id="boxBotones" spacing="8.0">
                     <padding>
                        <Insets top="4.0" />
                     </padding>
                     <children>
                        <Button fx:id="btnAnadir" maxWidth="1.7976931348623157E308" minWidth="90.0" onAction="#añadirSucursal" styleClass="btn-primary" text="Añadir" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnGestionar" maxWidth="1.7976931348623157E308" minWidth="90.0" onAction="#gestionarSucursal" styleClass="btn-filtrar" text="Modificar" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnEliminar" maxWidth="1.7976931348623157E308" minWidth="90.0" onAction="#eliminarSucursal" styleClass="btn-danger" text="Eliminar" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnVerMapa" maxWidth="1.7976931348623157E308" minWidth="150.0" onAction="#verEnMapa" styleClass="btn-secondary" text="Ver en Google Maps" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                     <padding>
                        <Insets top="6.0" />
                     </padding>
                     <children>
                        <Label styleClass="label-bold" text="Lista de Sucursales:" />
                        <ListView fx:id="listSucursales" minHeight="120.0" prefHeight="160.0" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
               </children>
            </VBox>


         </children>
      </HBox>
   </content>
</ScrollPane>