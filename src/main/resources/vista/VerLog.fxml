<!-- VER LOG: el administrador ve todas las operaciones registradas -->
<AnchorPane styleClass="panel-contenido" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.VerLogController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <children>
            <Label styleClass="titulo-principal" text="Fichero de log (telonda.log)" />
            <TextArea fx:id="txtLog" editable="false" style="-fx-font-family: monospace;" VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <Button fx:id="btnRefrescar" mnemonicParsing="true" onAction="#btnRefrescar" styleClass="btn-primary" text="_Refrescar">
                     <tooltip>
                        <Tooltip text="Vuelve a leer el fichero de log (Alt+R)" />
                     </tooltip>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
