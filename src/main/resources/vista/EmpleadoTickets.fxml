<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Tickets pendientes: resolverlos. -->
<AnchorPane stylesheets="@../css/Estilos.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.EmpleadoTicketsController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <!-- Cabecera: título y acciones -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="card">
               <children>
                  <Label styleClass="titulo-vista" text="Tickets pendientes" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnResolverTicket" mnemonicParsing="true" onAction="#btnResolverTicket" styleClass="btn-aceptar" text="_Resolver">
                     <tooltip>
                        <Tooltip text="Marca como resuelto el ticket seleccionado (Alt+R)" />
                     </tooltip>
                  </Button>
               </children>
            </HBox>
            <!-- Tabla -->
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tablaTickets" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <contextMenu>
                        <ContextMenu>
                           <items>
                              <MenuItem mnemonicParsing="false" onAction="#btnResolverTicket" text="Resolver ticket" />
                           </items>
                        </ContextMenu>
                     </contextMenu>
                     <columns>
                        <TableColumn fx:id="colTicketCliente" text="Cliente" />
                        <TableColumn fx:id="colTicketAsunto" text="Asunto" />
                        <TableColumn fx:id="colTicketDescripcion" text="Descripción" />
                        <TableColumn fx:id="colTicketFecha" text="Fecha" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
