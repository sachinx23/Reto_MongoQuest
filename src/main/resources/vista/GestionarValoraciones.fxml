<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="550.0" prefWidth="920.0" 
            styleClass="fondo-pantalla" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controlador.ValoracionController">
   <stylesheets>
      <URL value="@../css/Estilos.css" />
   </stylesheets>
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
            
            <!-- TARJETA SUPERIOR: CABECERA Y FILTRO POR PUNTUACIÓN -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
               <children>
                  <Label styleClass="titulo-vista" text="Valoraciones de Clientes" />
                  <Region HBox.hgrow="ALWAYS" />

                  <Label styleClass="label-bold" text="Puntuación:" />
                  <ComboBox fx:id="cbPuntuacion" prefWidth="130.0" styleClass="combo-box" />

                  <Button onAction="#btnFiltro" styleClass="btn-filtrar" text="Filtrar" />
               </children>
            </HBox>

            <!-- TABLA DE VALORACIONES -->
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colCliente" prefWidth="180.0" text="Cliente" />
                        <TableColumn fx:id="colTarifa" prefWidth="180.0" text="Tarifa" />
                        <TableColumn fx:id="colPuntuacion" prefWidth="110.0" text="Puntuación" />
                        <TableColumn fx:id="colTexto" prefWidth="380.0" text="Comentario" />
                     </columns>
                  </TableView>
               </children>
            </VBox>

            <!-- TARJETA INFERIOR: MEDIA DE VALORACIONES Y ACCIONES -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
               <children>
                  <Label styleClass="label-bold" text="Puntuación Media:" />
                  <Label fx:id="lblMedia" styleClass="titulo-principal" text="0.00 / 5" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#btnEliminar" styleClass="btn-danger" text="Eliminar Valoración" />
               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>