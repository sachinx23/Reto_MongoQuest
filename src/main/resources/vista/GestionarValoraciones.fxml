<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- VER VALORACIONES -->
<AnchorPane styleClass="panel-contenido" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.ValoracionController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <children>
            <Label styleClass="titulo-principal" text="Valoraciones de los clientes" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label styleClass="label-bold" text="Puntuación" />
                  <ComboBox fx:id="cmbPuntuacion" onAction="#cmbFiltrar" prefWidth="120.0">
                     <tooltip>
                        <Tooltip text="Enseña solo las valoraciones con esa puntuación" />
                     </tooltip>
                  </ComboBox>
                  <Label fx:id="lblMedia" styleClass="label-bold" />
               </children>
            </HBox>
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tablaValoraciones" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <contextMenu>
                        <ContextMenu>
                           <items>
                              <MenuItem mnemonicParsing="false" onAction="#btnEliminar" text="Eliminar valoración" />
                           </items>
                        </ContextMenu>
                     </contextMenu>
                     <columns>
                        <TableColumn fx:id="colCliente" text="Cliente" />
                        <TableColumn fx:id="colPuntuacion" text="Puntuación" />
                        <TableColumn fx:id="colTexto" text="Opinión" />
                     </columns>
                  </TableView>
                  <VBox minWidth="170.0" spacing="10.0">
                     <children>
                        <Button fx:id="btnEliminar" maxWidth="Infinity" mnemonicParsing="true" onAction="#btnEliminar" styleClass="btn-danger" text="_Eliminar">
                           <tooltip>
                              <Tooltip text="Borra la valoración seleccionada (Alt+E)" />
                           </tooltip>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
