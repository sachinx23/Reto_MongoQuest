<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="950.0" style="-fx-background-color: #1e293b;" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controlador.AdministradorController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
            
            <!-- BARRA SUPERIOR: DESPLEGABLE DE OPCIONES + NOMBRE ADMIN -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #0f172a; -fx-padding: 10 15 10 15; -fx-background-radius: 8;">
               <children>
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Panel Administrador:" textFill="WHITE" />
                  
                  <!-- COMBOBOX CON LAS OPCIONES DE NAVEGACIÓN -->
                  <ComboBox fx:id="cbOpcionesAdmin" onAction="#cambiarSubVista" prefWidth="280.0" promptText="Elegir opción..." />
                  
                  <!-- REGION FLEXIBLE PARA MOVER EL NOMBRE A LA DERECHA -->
                  <Region HBox.hgrow="ALWAYS" />
                  
                  <!-- NOMBRE DEL ADMINISTRADOR CONECTADO -->
                  <Label fx:id="lblNombreAdmin" text="Admin: Usuario" textFill="#38bdf8" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
               </children>
            </HBox>

            <!-- CONTENEDOR DINÁMICO DE SUBVISTAS -->
            <StackPane fx:id="contenidoDinamico" VBox.vgrow="ALWAYS" />

         </children>
      </VBox>
   </children>
</AnchorPane>